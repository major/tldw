# tldw environment example. Copy to .env and edit.

# --- PubSubHubbub ---
# Public URL the hub will POST notifications to. Required for subscriptions.
TLDW_CALLBACK_URL=https://your-tunnel.example/pubsub/callback

# Optional HMAC secret. When set, every incoming delivery must carry a
# matching X-Hub-Signature: sha1=... header. Leave unset for local testing.
# TLDW_HUB_SECRET=

# --- Discord delivery ---
# Webhook URL. When unset, the lifespan does not start the transcript worker
# at all: videos are enqueued but nothing is downloaded or sent. Set this and
# restart to drain the backlog. Required for end-to-end delivery.
# TLDW_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/1234567890/abcdefg

# --- Persistent storage ---
# Both paths MUST live on a persistent volume. Queue loss = silently
# dropped videos because the hub does not redeliver after a 200.
TLDW_QUEUE_FILE=/data/queue.sqlite3
# Directory for the audio pipeline's `.txt` transcript cache.
TLDW_TRANSCRIPT_DIR=/data/transcripts

# --- Worker pacing ---
# First retry delay (seconds). YouTube ASR usually needs 10-60 minutes.
TLDW_POLL_BASE_SECONDS=600
# Maximum retry delay (seconds). Caps the exponential growth.
TLDW_POLL_CAP_SECONDS=3600
# Stop retrying a video after this many seconds. 48h covers even the
# longest ASR backlogs; past that, captions are very likely never coming.
TLDW_GIVEUP_SECONDS=172800

# --- Transcript content ---
# How many lines to include in each Discord message.
TLDW_TRANSCRIPT_LINES=10

# --- Optional reliability ---
# Netscape-format cookies file. Recommended when YouTube applies bot
# checks to your egress IP. Refresh weekly.
# TLDW_YTDLP_COOKIES_FILE=/etc/yt-cookies.txt

# --- LLM video takeaways (OpenAI) ---
# API key for the OpenAI API. When unset, the takeaway step is skipped
# entirely: transcripts still post to Discord, but no LLM analysis runs.
# Required to enable takeaways.
# TLDW_OPENAI_API_KEY=
# Base URL and model name. The base URL also accepts any OpenAI-compatible
# endpoint.
TLDW_OPENAI_BASE_URL=https://api.openai.com/v1
TLDW_OPENAI_MODEL=gpt-6.1-sol
# Per-call request timeout, in seconds.
TLDW_LLM_TIMEOUT_SECONDS=180.0
# Maximum tokens the model may generate in one response.
TLDW_LLM_MAX_OUTPUT_TOKENS=2048
# Hard cap on transcript characters sent to the model. Longer transcripts are
# truncated to this many characters with a warning.
TLDW_LLM_MAX_INPUT_CHARS=300000
# Maximum bullets kept per takeaway item.
TLDW_TAKEAWAY_MAX_BULLETS=5

# --- Audio transcription pipeline ---
# Delay before the first audio download. Debounces notifications and gives
# YouTube's pipeline time to finish producing the video.
TLDW_AUDIO_DOWNLOAD_DELAY_SECONDS=300
# Directory for raw audio downloads and compressed artifacts. May be ephemeral:
# the worker re-downloads on crash before the transcript is cached.
TLDW_AUDIO_DIR=audio
# Output container for ffmpeg. Must be in OpenAI's accepted set: mp3, mp4,
# mpeg, mpga, m4a, wav, or webm. Use webm for the smallest files (Opus codec).
TLDW_AUDIO_FORMAT=webm
# Target bitrate for ffmpeg Opus encoding. 32k is enough for speech and keeps
# a 1-hour video under 15 MB, well under OpenAI's 25 MB upload limit.
TLDW_AUDIO_BITRATE=32k
# Per-call ffmpeg timeout, in seconds.
TLDW_FFMPEG_TIMEOUT_SECONDS=900
# OpenAI speech-to-text model. gpt-transcribe is the current recommended model;
# the gpt-4o-transcribe family is deprecated and shuts down 2027-02-26.
TLDW_TRANSCRIBE_MODEL=gpt-transcribe
# JSON list of ISO-639-1 language hints to pass to the transcription API.
TLDW_TRANSCRIBE_LANGS=["en"]
# Per-call transcription timeout, in seconds.
TLDW_TRANSCRIBE_TIMEOUT_SECONDS=600

# --- Content filter ---
# When true, YouTube Shorts (URLs under /shorts/<id>) are delivered alongside
# full-length videos. Unset or false keeps the digest focused on long-form
# uploads only.
# TLDW_INCLUDE_SHORTS=false
